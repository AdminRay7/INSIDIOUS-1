# ═══════════════════════════════════════════════
#   INSIDIOUS BOT — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════

# ─── Bot Identity ───────────────────────────────
BOT_NAME=INSIDIOUS
OWNER_NUMBER=2557xxxxxx
OWNER_NAME=StanyTZ
PREFIX=.
FOOTER=© INSIDIOUS BOT
VERSION=2.1.1

# ─── Session (REQUIRED) ─────────────────────────
# Paste the Session ID from the generator.
# It must start with:  _INSIDIOUS_"
SESSION_ID=

# ─── HTTP API Key (REQUIRED for /api/send etc.) ─
# Change this to a long random string.
API_KEY=change-this-key-please

# ─── Database (Optional) ────────────────────────
# Only needed if you use commands that store data (autosave, antidelete, etc.)
MONGODB_URI=

# ─── Channel (Optional) ─────────────────────────
NEWSLETTER_JID=
CHANNEL_LINK=

# ─── Feature Toggles (true/false) ───────────────
AUTO_READ=true
AUTO_REACT=true
AUTO_SAVE=true
AUTO_TYPING=false
AUTO_BIO=true

ANTICALL=true
ANTIBUG=true
ANTISPAM=true
ANTILINK=false
ANTISCAM=true
ANTIPORN=true
ANTIDELETE=true

# Media blocking mode: off | all | photo | video | sticker
ANTIMEDIA=off

# Work mode: public | private
WORK_MODE=public

# ─── Auto Status ────────────────────────────────
AUTO_STATUS_VIEW=true
AUTO_STATUS_LIKE=true
AUTO_STATUS_REPLY=false

# ─── Autoblock ──────────────────────────────────
# Comma-separated country codes (no + sign)
# Example: 234,91,92
AUTOBLOCK=

# ─── Sleep Mode ─────────────────────────────────
SLEEP_START=23:00
SLEEP_END=06:00

# ─── Web Server ─────────────────────────────────
PORT=3000