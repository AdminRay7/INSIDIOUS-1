# Bot Configuration
BOT_NAME=INSIDIOUS
OWNER_NUMBER=2557xxxxxx
OWNER_NAME=StanyTZ
PREFIX=.

# Database (Required for Render)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/insidious

# Channel (Optional)
NEWSLETTER_JID=120363xxxxxx@newsletter
CHANNEL_LINK=https://whatsapp.com/channel/...

# Features (true/false)
AUTO_READ=true
AUTO_REACT=true
AUTO_SAVE=true
AUTO_TYPING=false
AUTO_BIO=true
ANTICALL=true
ANTIBUG=true
ANTISPAM=true
ANTILINK=false
ANTISCAM=true
ANTIPORN=true
